# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_QUEUE=inference_queue

# Local Ollama Fallback Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Hybrid Cloud Inference Configuration (Groq)
INFERENCE_BACKEND=groq
CLOUD_API_KEY=YOUR_GROQ_API_KEY_HERE
CLOUD_MODEL=llama-3.1-8b-instant
CLOUD_MAX_REQUESTS=500

# Worker Tier (fast | heavy)
WORKER_TIER=fast
